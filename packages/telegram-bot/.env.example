# Bot
TELEGRAM_BOT_TOKEN=           # From @BotFather
ADMIN_TELEGRAM_IDS=           # Comma-separated allowed user IDs (required; empty = bot denies everyone)
ALLOW_ALL_USERS=              # Set "true" to allow every user when no admin IDs are set (dev only)

# Database
MONGODB_URI=                  # MongoDB Atlas connection string

# Upstash Box
UPSTASH_BOX_API_KEY=          # Box API key (can be updated at runtime via /setapikey)
AGENT_API_KEY=                # Optional: default agent LLM key (updatable via /setagentkey)

# Web Admin
ADMIN_USERNAME=
ADMIN_PASSWORD=               # bcrypt hash ($2a$/$2b$/$2y$…) or plaintext for quick setups
JWT_SECRET=

# Deployment
PORT=3000                     # Web admin port
BOT_MODE=polling              # "polling" for dev/VPS, "webhook" for Render/production
WEBHOOK_URL=                  # Required when BOT_MODE=webhook
WEBHOOK_SECRET=               # Recommended in webhook mode — rejects forged Telegram updates
BOX_WEBHOOK_SECRET=           # Required to enable the box → bot notification webhook
