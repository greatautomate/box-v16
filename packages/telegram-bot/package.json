{
  "name": "@medusaxd/claude-bot",
  "version": "0.1.0",
  "description": "MedusaXD Claude Bot — Telegram bot + web admin for Upstash Box",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && node -e \"const{cpSync}=require('fs');cpSync('src/web/public','dist/web/public',{recursive:true})\"",
    "dev": "tsc --watch",
    "start": "node dist/main.js",
    "test": "vitest run",
    "lint": "prettier --check . --write",
    "ci:lint": "prettier --check ."
  },
  "dependencies": {
    "@upstash/box": "^0.6.3",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.3.1",
    "express": "^5.1.0",
    "grammy": "^1.35.0",
    "input": "^1.0.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.14.0",
    "telegram": "^2.26.22",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^20.10.0",
    "prettier": "^3.8.1",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
